# ==============================================================================
# CropCare AI – Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local customization:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# IMPORTANT: Never commit actual keys, tokens, or credentials to version control.
# The .env file is strictly ignored in .gitignore.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Node native SQLite DatabaseSync)
# Defaults to data/cropcare.db relative to repository root
DATABASE_PATH=./data/cropcare.db

# Upload Storage (Local filesystem storage for uploaded crop pathology photos)
# Stored images remain on disk in UPLOADS_DIR and are never transmitted to external
# services unless an AI provider is explicitly configured below.
UPLOADS_DIR=./uploads

# Client API Proxy Configuration
VITE_API_URL=http://localhost:5000

# ==============================================================================
# 1. AI Crop Pathology Vision Integration (Optional)
# ==============================================================================
# AI_PROVIDER options:
# - 'demo'        : (Default) Local offline demonstration mode. No network calls,
#                   no credentials needed, and no fabricated confidence scores.
# - 'gemini'      : Google Gemini Multimodal Vision API (requires GEMINI_API_KEY).
# - 'custom_http' : Self-hosted or external ONNX / PyTorch inference service.
# - 'mock_ai'     : Deterministic test suite mock (controlled by MOCK_AI_MODE).
AI_PROVIDER=demo

# Google Gemini Vision Configuration
# How to get an API key:
# 1. Visit Google AI Studio at https://aistudio.google.com
# 2. Create a free API key
# 3. Paste the key below and set AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Custom Vision Endpoint Configuration
# To connect your own plant pathology model microservice:
VISION_MODEL_ENDPOINT=
VISION_API_KEY=
VISION_MODEL_NAME=custom-onnx-detector

# Mock AI Testing Settings (Used by automated Vitest suite)
# Modes: success | low_confidence | unsupported_crop | timeout | malformed | error
MOCK_AI_MODE=success

# ==============================================================================
# 2. Online Payment Gateway Integration (Optional – Currently in Demo Mode)
# ==============================================================================
# PAYMENT_PROVIDER options:
# - 'demo' : (Default) Simulated checkout flow. Generates tracking numbers
#            (AGRI-EXP-XXXXXX) and records orders without live financial charges.
# - 'razorpay' : Indian agricultural payments (Cards, UPI, Netbanking).
# - 'stripe'   : International card processing.
PAYMENT_PROVIDER=demo

# Razorpay Configuration (https://dashboard.razorpay.com)
# Setup: Sign up for Razorpay -> Settings -> API Keys -> Generate Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe Configuration (https://dashboard.stripe.com)
# Setup: Sign up for Stripe -> Developers -> API Keys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ==============================================================================
# 3. Agronomist Video Consultation Integration (Optional – Currently in Demo Mode)
# ==============================================================================
# VIDEO_PROVIDER options:
# - 'demo'  : (Default) Generates simulated secure video room links.
# - 'agora' : Agora RTC video calling SDK.
# - 'jitsi' : Self-hosted or meet.jit.si open-source video rooms.
VIDEO_PROVIDER=demo

# Agora RTC Configuration (https://console.agora.io)
# Setup: Sign up -> Projects -> Create Project -> App ID & App Certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ==============================================================================
# 4. Expert Calendar Scheduling Integration (Optional – Currently in Demo Mode)
# ==============================================================================
# CALENDAR_PROVIDER options:
# - 'demo'   : (Default) Local SQLite appointment booking without external sync.
# - 'google' : Google Calendar API (requires Google Cloud OAuth2 credentials).
CALENDAR_PROVIDER=demo

# Google Calendar OAuth2 Configuration (https://console.cloud.google.com)
# Setup: Enable Google Calendar API -> Create OAuth 2.0 Client ID
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/bookings/oauth2callback
